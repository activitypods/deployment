BACKEND_DOMAIN_NAME=mypod.store
FRONTEND_DOMAIN_NAME=app.mypod.store
LETSENCRYPT_EMAIL=
FUSEKI_PASSWORD=

# Version of ActivityPods to run (tag of the activitypods/backend and activitypods/frontend images).
# Read the upgrade notes before changing it: some versions require a migration.
ACTIVITYPODS_VERSION=latest

# Fuseki (triplestore) image version and memory limit. The JVM heap is 65% of the limit.
# Keep the limit well under the server memory: the backend and Redis need some too.
FUSEKI_VERSION=v1.0.1
FUSEKI_MEMORY_LIMIT=4g
FUSEKI_JVM_ARGS=
